{
  "name": "hiho-html-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "build": "pnpm run build:site && pnpm run build:css",
    "build:css": "tailwindcss -i .github/pages/index.css -o _site/viewer.css --minify",
    "build:site": "node .github/pages/build.ts",
    "lint": "eslint .github/pages --max-warnings 0",
    "test": "node --test --test-isolation=none .github/pages/build.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "zod": "4.4.3"
  }
}
